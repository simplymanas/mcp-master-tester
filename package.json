{
  "name": "mcp-master-tester",
  "version": "1.3.1",
  "description": "Local web UI to connect, inspect and test any MCP server — stdio, Streamable HTTP & SSE, with auth prompts, schema-driven tool forms, elicitation, linting, a one-click smoke test and a live JSON-RPC log. Lint and smoke-test from the command line in CI.",
  "type": "module",
  "bin": {
    "mcp-master-tester": "cli.js"
  },
  "files": [
    "cli.js",
    "server.js",
    "public"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-client",
    "inspector",
    "testing",
    "json-rpc",
    "developer-tools"
  ],
  "author": "@simplymanas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simplymanas/mcp-master-tester.git"
  },
  "homepage": "https://github.com/simplymanas/mcp-master-tester#readme",
  "bugs": {
    "url": "https://github.com/simplymanas/mcp-master-tester/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-everything": "^2026.8.31"
  }
}
