{
  "name": "mcp-master-tester",
  "version": "1.12.0",
  "description": "Debug any MCP server in a local web UI, then guard it in CI: lint with a token budget, a smoke test, a lockfile diff that catches breaking changes, and tool-selection evals. stdio, Streamable HTTP and SSE; a GitHub Action.",
  "type": "module",
  "bin": {
    "mcp-master-tester": "cli.js"
  },
  "files": [
    "cli.js",
    "server.js",
    "public"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-client",
    "inspector",
    "testing",
    "json-rpc",
    "developer-tools",
    "lint",
    "smoke-test",
    "ci",
    "github-action",
    "lockfile",
    "breaking-changes",
    "evals",
    "tool-selection",
    "token-budget",
    "ai-agents"
  ],
  "author": "@simplymanas",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simplymanas/mcp-master-tester.git"
  },
  "homepage": "https://simplymanas.github.io/mcp-master-tester/",
  "bugs": {
    "url": "https://github.com/simplymanas/mcp-master-tester/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "gpt-tokenizer": "^4.1.2"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "gpt-tokenizer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@modelcontextprotocol/server-everything": "^2026.8.31",
    "gpt-tokenizer": "^4.1.2"
  }
}
